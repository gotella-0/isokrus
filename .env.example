# --- Доступ к LLM (обязательно) -------------------------------------------
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.dslab.tech/v1
LLM_MODEL=glm-5.3-flash

# --- Поведение LLM ---------------------------------------------------------
# high | medium | low — режим размышления. По умолчанию high.
LLM_REASONING_EFFORT=high
LLM_TIMEOUT=600
# Повторов сверх первой попытки (всего попыток = LLM_MAX_RETRIES + 1).
# Сетевой сбой — повтор того же запроса 1-в-1; невалидный JSON — повтор
# с возвратом модели её ответа и ошибки валидации. Формат всегда strict.
LLM_MAX_RETRIES=3
# Базовая пауза перед повтором, дальше удваивается (потолок 30 с).
LLM_RETRY_BACKOFF=2.0
# Тарифы за 1M токенов для расчёта стоимости. Все нули = не считать.
# Токены рассуждения входят в completion, но тарифицируются отдельно:
# LLM_PRICING_REASONING=0 означает «столько же, сколько output».
LLM_PRICING_INPUT=0
LLM_PRICING_OUTPUT=0
LLM_PRICING_REASONING=0
# Тариф за запись в кеш и за чтение из него. Учти: prompt_tokens у провайдера
# включают и то, и другое, поэтому обычный вход считается как prompt минус
# кеш — иначе эти токены оплачиваются дважды.
LLM_PRICING_CACHE_WRITE=0
LLM_PRICING_CACHE_READ=0
LLM_PRICING_CURRENCY=USD

# Тарифы по моделям (JSON). Общие настройки выше применяются к моделям, которых
# нет в таблице. Нужны, когда модель переключается флагом --model, а цены
# разные: иначе отчёт показывает стоимость дорогой модели по тарифу дешёвой.
# Ключ "default" — запасной тариф для любой модели.
# Если таблица задана, а модели в ней нет и "default" отсутствует, стоимость
# считается неизвестной (cost_known: false), а не подставляется чужая.
# LLM_PRICING_TABLE={"gpt-6-luna": {"input": 10, "output": 50, "reasoning": 50, "cache_write": 12.5, "cache_read": 1.25}, "default": {"input": 7.5, "output": 25, "reasoning": 25}}

# --- Обработка -------------------------------------------------------------
# Максимум одновременных вызовов LLM
MAX_PARALLEL=10
# Плотность рендера страниц PDF
RENDER_DPI=320
# Ограничение по большей стороне изображения в пикселях
MAX_IMAGE_SIDE=6144

# --- Обрезка пустых полей листа ---------------------------------------------
# Обрезать поля, по которым ничего не нарисовано (аналог str.strip для
# картинки). Рамка ищется по пикселям, заранее заданных полей нет. Обрезка идёт
# до извлечения текстового слоя, поэтому координаты подписей в промте и рамки
# в разметке считаются в пикселях обрезанной картинки. Отключается --no-trim.
TRIM_MARGINS=1
# Белый запас вокруг среза, px: у самого края не должна стоять графика.
TRIM_PAD_PX=12
# На сколько уровней пиксель должен быть темнее фона, чтобы считаться
# нарисованным. Фон берётся из левого верхнего угла листа, поэтому серый скан
# обрабатывается так же, как белый.
TRIM_NOISE=8
# Сколько тёмных пикселей в строке/столбце считать содержимым. 1 = не резать
# ничего, что хоть чем-то похоже на содержимое. Больше 1 нужно для сканов:
# одиночная тёмная пылинка иначе отменяет обрезку всего листа.
TRIM_MIN_INK=1
# Поле тоньше этого числа клеток уменьшенной копии — край, а не поле.
TRIM_MIN_RUN=2
# Ширина уменьшенной копии, по которой ищется рамка, px. Меньше = точнее и
# медленнее.
TRIM_PROBE_SIDE=2048
# Не обрезать, если результат уже этого размера, px.
TRIM_MIN_SIDE=96

# --- Текстовый слой PDF ----------------------------------------------------
# Доставать из PDF подписи вместе с координатами и подставлять их в
# системный промт (токен {{PDF_TEXT}}). Разметка потом берёт рамки оттуда
# же, поэтому координаты точные, а не угаданные моделью.
EXTRACT_PDF_TEXT=1
# Отсечь подписи ниже указанной высоты шрифта в пикселях рендера (0 — нет)
PDF_TEXT_MIN_HEIGHT_PX=0
# Лимит подписей на лист в промте, 0 = без лимита. Обрезание равномерное.
PDF_TEXT_MAX_ITEMS=0

# --- Разметка --------------------------------------------------------------
# Система координат bbox в ответе модели:
#   norm1000 — 0..1000 от левого верхнего угла;
#   px       — пиксели картинки (как в блоке извлечённого текста).
# Учитывается только когда у листа нет текстового слоя.
ANNOTATE_COORD_SPACE=norm1000

# --- Эксперименты и пути ---------------------------------------------------
# Эксперимент по умолчанию (папка в research/)
EXPERIMENT=exp_01
# RESEARCH_DIR=./research
# OUTPUT_DIR=./output
